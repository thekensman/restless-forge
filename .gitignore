# Dependencies
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# Build output
dist/
tools/*/frontend/dist/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Env files
.env
.env.local

# Logs
*.log

# Local backend state (RF_DB_PATH default)
backend/.data/

# Generated by tools/tattoosafe/frontend/scripts/fetch-ar-assets.mjs
tools/tattoosafe/frontend/public/ar/

# Restored games (games/<slug>/)
# Temp file boot_e2e.mjs writes while it runs, and the browser test's screenshots.
games/*/.e2e_boot.mjs
games/*/shots/
# Reverse-engineering inputs. The original archive carries the old mailing
# address that must never go online (games/foobar-vs-the-dea/HANDOFF.md), and
# none of these belong in the repo.
games/**/*.hqx
games/**/*.rsrc
games/**/resource_fork.bin
games/**/multiversal/
games/**/*.mp4
