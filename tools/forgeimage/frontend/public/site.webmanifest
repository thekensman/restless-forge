  "icons": [
    {
      "src": "/tools/forgeimage/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/tools/forgeimage/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}