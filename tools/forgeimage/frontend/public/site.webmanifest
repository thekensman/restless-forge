{
  "name": "ForgeImage",
  "short_name": "ForgeImage",
  "description": "Resize, crop, convert, compress, and social-media sizes. All in your browser, no uploads.",
  "start_url": "/tools/forgeimage/",
  "scope": "/tools/forgeimage/",
  "display": "standalone",
  "background_color": "#0b0d12",
